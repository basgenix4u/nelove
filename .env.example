# --- server ---
NODE_ENV=production
PORT=8787
PUBLIC_URL=https://your-domain.com
DB_FILE=./nelove.db

# --- auth ---
JWT_SECRET=generate-a-long-random-hex-string
SESSION_TTL_DAYS=14
ADMIN_EMAIL=admin@nelove.ng
ADMIN_PASSWORD=change-me-before-deploy

# --- payments (Paystack) ---
PAYSTACK_SECRET_KEY=sk_live_xxx          # leave blank to disable card payments

# --- images (Cloudinary, optional — local disk fallback otherwise) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nelove
